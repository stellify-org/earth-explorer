# Copy to .env if you need to change defaults. No secrets are required.
WEB_PORT=8088
LOG_LEVEL=info

# Backend (when running outside Docker)
PORT=8787
CACHE_DIR=../data/cache
GRIDS_DIR=../data/grids
# CORS_ORIGIN=http://localhost:5173   # only needed if the SPA is served from another origin without the Vite proxy
# POWER_BASE_URL=https://power.larc.nasa.gov
# GIBS_CAPABILITIES_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/1.0.0/WMTSCapabilities.xml
# USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# Future (not used yet): NASA Earthdata Login token for MERRA-2/GLDAS/IMERG subsetting.
# It must only ever be given to backend/ETL processes, never to the browser.
# EARTHDATA_TOKEN=
